<!-- BinaryForge hero: tagline, one sentence, two actions.
     OWNER: all words come from src/data/content.ts (hero). -->
---
import Button from '../components/Button.astro';
import { hero } from '../data/content';
---

<section class="hero" aria-labelledby="hero-title">
  <!-- Photo backdrop with a page-tone wash so type keeps full contrast. -->
  <div class="hero-bg" aria-hidden="true">
    <img
      src="/hero-bg.jpg"
      alt=""
      width="1920"
      height="1280"
      loading="eager"
      fetchpriority="high"
    />
  </div>
  <div class="container hero-inner">
    <h1 id="hero-title" class="display hero-title">{hero.title}</h1>
    <p class="lede hero-lede">{hero.intro}</p>
    <div class="hero-actions">
      <Button href={hero.primaryCta.href} label={hero.primaryCta.label} />
      <a class="link-arrow" href={hero.secondaryCta.href}>
        {hero.secondaryCta.label}
        <span class="arrow" aria-hidden="true">&rarr;</span>
      </a>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: flex;
    align-items: center;
    /* Roughly one viewport with room to breathe. 88vh first as the
       fallback for browsers without svh. */
    min-height: 88vh;
    min-height: 88svh;
    margin-top: -76px; /* slide under the floating navbar: photo to the very top */
    padding: 196px 0 180px;
    overflow: hidden; /* overflow: clip is preferred where supported */
    overflow: clip;
  }
  /* Photo backdrop, calmed by a flat page-tone wash for contrast. */
  .hero-bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .hero-bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }
  .hero-bg::after {
    content: '';
    position: absolute;
    inset: 0;
    /* 68% page-tone wash: literal value first (no color-mix support),
       then the token calc so it tracks a theme color change. */
    background: rgb(219 224 230 / 0.68);
    background: color-mix(in srgb, var(--bg) 68%, transparent);
  }
  .hero-inner {
    position: relative;
    display: grid;
    gap: 32px;
    justify-items: start; /* left edge alignment: headline, body, buttons */
  }
  .hero-title {
    max-width: 12ch;
  }
  .hero-lede {
    max-width: 38rem;
    margin-top: -2px; /* optical nudge: sits 2px higher */
  }
  .hero-actions {
    display: flex;
    align-items: center;
    gap: 32px;
    flex-wrap: wrap;
  }
  @media (max-width: 768px) {
    .hero {
      padding: 156px 0 120px;
    }
    .hero-actions {
      gap: 16px 24px;
    }
  }
</style>
