<!-- HAUTEK hero: photo backdrop, headline, one sentence, two actions.
     OWNER: all words come from src/data/content.ts (hero). -->
---
import Button from '../components/Button.astro';
import { hero } from '../data/content';
---

<section class="hero" aria-labelledby="hero-title">
  <!-- Photo backdrop with a page-tone wash so type keeps full contrast. -->
  <div class="hero-bg" aria-hidden="true">
    <img
      src="/hero-bg.jpg"
      alt=""
      width="1920"
      height="1280"
      loading="eager"
      fetchpriority="high"
    />
  </div>
  <div class="container hero-inner">
    <h1 id="hero-title" class="display hero-title">{hero.title}</h1>
    <p class="lede hero-lede">{hero.intro}</p>
    <div class="hero-actions">
      <Button href={hero.primaryCta.href} label={hero.primaryCta.label} />
      <a class="link-arrow" href={hero.secondaryCta.href}>
        {hero.secondaryCta.label}
        <span class="arrow" aria-hidden="true">&rarr;</span>
      </a>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: flex;
    align-items: center;
    /* Roughly one viewport with room to breathe. 88vh first as the
       fallback for browsers without svh. */
    min-height: 88vh;
    min-height: 88svh;
    margin-top: -76px; /* slide under the floating navbar: photo to the very top */
    padding: 196px 0 180px;
    overflow: hidden; /* overflow: clip is preferred where supported */
    overflow: clip;
  }
  /* Photo backdrop. A light asymmetric wash: stronger at the left edge
     where the headline sits, almost bare on the right, so the photo's
     teal sky stays vivid while ink type keeps its contrast. Both
     gradients declare literal values first (no color-mix support),
     then the token calc so it tracks a theme change. */
  .hero-bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .hero-bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }
  .hero-bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      90deg,
      rgb(246 247 249 / 0.55) 0%,
      rgb(246 247 249 / 0.28) 45%,
      rgb(246 247 249 / 0.16) 100%
    );
    background: linear-gradient(
      90deg,
      color-mix(in srgb, var(--bg) 55%, transparent) 0%,
      color-mix(in srgb, var(--bg) 28%, transparent) 45%,
      color-mix(in srgb, var(--bg) 16%, transparent) 100%
    );
  }
  @media (max-width: 768px) {
    /* Text spans the full width on small screens, so even the wash
       out evenly instead of leaving dark photo behind the words. */
    .hero-bg::after {
      background: rgb(246 247 249 / 0.5);
      background: color-mix(in srgb, var(--bg) 50%, transparent);
    }
  }
  .hero-inner {
    position: relative;
    display: grid;
    gap: 32px;
    justify-items: start; /* left edge alignment: headline, body, buttons */
  }
  .hero-title {
    max-width: 12ch;
  }
  .hero-lede {
    max-width: 38rem;
    margin-top: -2px; /* optical nudge: sits 2px higher */
  }
  .hero-actions {
    display: flex;
    align-items: center;
    gap: 32px;
    flex-wrap: wrap;
  }
  @media (max-width: 768px) {
    .hero {
      padding: 156px 0 120px;
    }
    .hero-actions {
      gap: 16px 24px;
    }
  }
</style>
