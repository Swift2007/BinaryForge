<!-- HAUTEK hero: photo backdrop, headline, one sentence, two actions.
     OWNER: all words come from src/data/content.ts (hero). -->
---
import Button from '../components/Button.astro';
import { hero } from '../data/content';
---

<section class="hero" aria-labelledby="hero-title">
  <!-- Photo backdrop with a page-tone wash so type keeps full contrast. -->
  <div class="hero-bg" aria-hidden="true">
    <img
      src="/hero-bg.jpg"
      alt=""
      width="1920"
      height="1280"
      loading="eager"
      fetchpriority="high"
    />
  </div>
  <div class="container hero-inner">
    <h1 id="hero-title" class="display hero-title">{hero.title}</h1>
    <p class="lede hero-lede">{hero.intro}</p>
    <div class="hero-actions">
      <Button href={hero.primaryCta.href} label={hero.primaryCta.label} />
      <a class="link-arrow" href={hero.secondaryCta.href}>
        {hero.secondaryCta.label}
        <span class="arrow" aria-hidden="true">&rarr;</span>
      </a>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: flex;
    align-items: center;
    /* Full first screen: the photo runs from above the top edge (under
       the floating navbar) to the exact bottom edge of the viewport, so
       no bare background shows before the first scroll. The 12px matches
       the navbar offset that the -76px margin consumes. vh first as the
       fallback for browsers without svh. */
    min-height: calc(100vh + 12px);
    min-height: calc(100svh + 12px);
    margin-top: -76px; /* slide under the floating navbar: photo to the very top */
    padding: 196px 0 180px;
    overflow: hidden; /* overflow: clip is preferred where supported */
    overflow: clip;
  }
  /* Photo backdrop with a page-tone wash so type keeps clear contrast
     while the hero image still reads as a rich, full-bleed splash. */
  .hero-bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .hero-bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transform-origin: center;
    will-change: transform, opacity;
  }
  .hero-bg::after {
    content: '';
    position: absolute;
    inset: 0;
    /* Desktop: asymmetric wash, stronger behind the headline. */
    background: linear-gradient(
      90deg,
      rgb(246 247 249 / 0.38) 0%,
      rgb(246 247 249 / 0.18) 42%,
      rgb(246 247 249 / 0.06) 100%
    );
    background: linear-gradient(
      90deg,
      color-mix(in srgb, var(--bg) 38%, transparent) 0%,
      color-mix(in srgb, var(--bg) 18%, transparent) 42%,
      color-mix(in srgb, var(--bg) 6%, transparent) 100%
    );
  }
  .hero-inner {
    position: relative;
    display: grid;
    gap: 32px;
    justify-items: start; /* left edge alignment: headline, body, buttons */
  }
  .hero-title {
    max-width: 12ch;
  }
  .hero-lede {
    max-width: 38rem;
    margin-top: -2px; /* optical nudge: sits 2px higher */
  }
  .hero-actions {
    display: flex;
    align-items: center;
    gap: 32px;
    flex-wrap: wrap;
  }

  @media (max-width: 768px) {
    .hero {
      min-height: calc(100svh + 12px);
      padding: 132px 0 104px;
      align-items: center;
    }
    .hero-inner {
      gap: 20px;
    }
    .hero-title {
      max-width: 11ch;
    }
    .hero-lede {
      max-width: 34rem;
    }
    .hero-actions {
      width: 100%;
      flex-direction: column;
      align-items: stretch;
      gap: 12px;
    }
    .hero-actions :global(.btn) {
      width: 100%;
    }
    .hero-actions .link-arrow {
      justify-content: center;
      width: 100%;
      min-height: 44px;
    }
    /* Mobile: a lighter splash wash to keep the photo visible while
       preserving readable contrast behind the content. */
    .hero-bg::after {
      background: linear-gradient(
        180deg,
        rgb(246 247 249 / 0.58) 0%,
        rgb(246 247 249 / 0.38) 36%,
        rgb(246 247 249 / 0.18) 70%,
        rgb(246 247 249 / 0.08) 100%
      );
      background: linear-gradient(
        180deg,
        color-mix(in srgb, var(--bg) 58%, transparent) 0%,
        color-mix(in srgb, var(--bg) 38%, transparent) 36%,
        color-mix(in srgb, var(--bg) 18%, transparent) 70%,
        color-mix(in srgb, var(--bg) 8%, transparent) 100%
      );
    }
  }

  @media (max-width: 480px) {
    .hero {
      padding: 124px 0 96px;
    }
    .hero-title {
      max-width: 10ch;
    }
  }
</style>
