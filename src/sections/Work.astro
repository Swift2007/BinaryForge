<!-- HAUTEK work: selected projects, one row each, linking to the
     project pages. OWNER: edit entries in src/data/content.ts (work). -->
---
import { work } from '../data/content';
---

<section id="work" class="section work" aria-labelledby="work-heading">
  <div class="container">
    <p class="eyebrow">{work.eyebrow}</p>
    <h2 id="work-heading" class="h2">{work.heading}</h2>
    <p class="body-copy">{work.intro}</p>

    <ul class="work-list">
      {
        work.items.map((w) => (
          <li class="work-item">
            <span class="work-index" aria-hidden="true">
              {w.index}
            </span>
            <div class="work-body">
              <h3>{w.title}</h3>
              <p>{w.text}</p>
            </div>
            <a
              class="work-link"
              href={w.href}
              aria-label={`${w.cta}: ${w.title}`}
            >
              <span class="work-link-text">{w.cta}</span>
              <span class="arrow" aria-hidden="true">
                &rarr;
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .work .eyebrow {
    margin-bottom: 24px;
  }
  .work .h2 {
    margin-bottom: 16px;
  }
  .work .body-copy {
    margin-bottom: 64px;
  }
  .work-list {
    list-style: none;
    padding: 0;
    border-top: 1px solid var(--border);
  }
  /* Same quiet row grammar as the services list. */
  .work-item {
    display: grid;
    grid-template-columns: 80px 1fr auto;
    gap: 24px;
    align-items: center;
    padding-block: 40px;
    border-bottom: 1px solid var(--border);
  }
  .work-index {
    font-size: 0.875rem;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.04em;
  }
  .work-body h3 {
    font-size: clamp(1.25rem, 1.1rem + 0.6vw, 1.5rem);
    margin-bottom: 8px;
  }
  .work-body p {
    color: var(--muted);
    font-size: 1rem;
    max-width: 52ch;
  }
  .work-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--muted);
    font-size: 0.9375rem;
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
    transition: color 200ms ease-out;
  }
  .work-link .arrow {
    transition: transform 200ms ease-out;
  }
  .work-link:hover {
    color: var(--text);
  }
  .work-link:hover .arrow {
    transform: translateX(4px);
    color: var(--accent);
  }
  @media (max-width: 768px) {
    .work-item {
      grid-template-columns: 1fr;
      gap: 12px;
      padding-block: 32px;
    }
    .work-link {
      margin-top: 8px;
    }
  }
</style>
