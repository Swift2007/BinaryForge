<!-- HAUTEK "Why we exist": statement + three quiet principles.
     OWNER: edit the story and principles in src/data/content.ts (whyUs). -->
---
import { whyUs } from '../data/content';
---

<section id="why-us" class="section why" aria-labelledby="why-heading">
  <div class="container">
    <p class="eyebrow">{whyUs.eyebrow}</p>
    <h2 id="why-heading" class="sr-only">Why we exist</h2>
    <p class="statement">{whyUs.statement}</p>
    <div class="principles">
      {
        whyUs.principles.map((p) => (
          <div class="principle">
            <h3>{p.title}</h3>
            <p>{p.text}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  /* Same quiet label as the other sections (13px overline from the
     base .eyebrow): with the statement reduced, a 28px label would
     outweigh its own content. */
  .why .eyebrow {
    margin-bottom: 24px;
  }
  /* Statement reduced to the page's supporting-text scale: the hero
     lede is 18-20px and section intros are 17px, so a 34px paragraph
     stood apart. 20-24px keeps it the section's focal point without
     overpowering the rest. */
  .statement {
    font-size: clamp(1.25rem, 1.15rem + 0.5vw, 1.5rem); /* 20 -> 24px */
    line-height: 1.45;
    letter-spacing: -0.01em;
    font-weight: 400;
    color: var(--text);
    max-width: 32ch;
    text-wrap: balance;
  }
  /* Three quiet columns separated by 1px hairlines. No icons. */
  .principles {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    margin-top: 80px;
    border-top: 1px solid var(--border);
  }
  .principle {
    padding: 32px 32px 8px 0;
  }
  .principle + .principle {
    border-left: 1px solid var(--border);
    padding-left: 32px;
  }
  .principle h3 {
    font-size: 1.0625rem;
    letter-spacing: -0.01em;
    margin-bottom: 12px;
  }
  .principle p {
    color: var(--muted);
    font-size: 1rem;
    line-height: 1.6;
    max-width: 32ch;
  }
  @media (max-width: 768px) {
    .principles {
      grid-template-columns: 1fr;
      margin-top: 64px;
    }
    .principle {
      padding: 32px 0;
    }
    .principle + .principle {
      border-left: 0;
      border-top: 1px solid var(--border);
      padding-left: 0;
    }
  }
</style>
