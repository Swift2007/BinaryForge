<!-- HAUTEK services: four borderless rows with hairline dividers.
     OWNER: edit titles and descriptions in src/data/content.ts (services). -->
---
import { services } from '../data/content';
---

<section id="services" class="section services" aria-labelledby="services-heading">
  <div class="container">
    <p class="eyebrow">{services.eyebrow}</p>
    <h2 id="services-heading" class="h2">{services.heading}</h2>
    <p class="body-copy">{services.intro}</p>

    <ul class="service-list">
      {
        services.items.map((s) => (
          <li class="service" id={s.id}>
            <span class="service-index" aria-hidden="true">
              {s.index}
            </span>
            <div class="service-body">
              <h3>{s.title}</h3>
              <p>{s.text}</p>
            </div>
          </li>
        ))
      }
    </ul>
    {/* One call to action closes the list, so the section asks once. */}
    <a class="services-cta" href={services.cta.href}>
      <span>{services.cta.label}</span>
      <span class="arrow" aria-hidden="true">
        &rarr;
      </span>
    </a>
  </div>
</section>

<style>
  .services .eyebrow {
    margin-bottom: 24px;
  }
  .services .h2 {
    margin-bottom: 16px;
  }
  .services .body-copy {
    margin-bottom: 64px;
  }
  .service-list {
    list-style: none;
    padding: 0;
    border-top: 1px solid var(--border);
  }
  /* Large borderless cells, one hairline between each. Quiet by design. */
  .service {
    display: grid;
    grid-template-columns: 80px 1fr;
    gap: 24px;
    align-items: center;
    padding-block: 40px;
    border-bottom: 1px solid var(--border);
    /* Row ids are deep-link targets from the footer's Services column. */
    scroll-margin-top: 96px;
  }
  .service-index {
    font-size: 0.875rem;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.04em;
  }
  .service-body h3 {
    font-size: clamp(1.25rem, 1.1rem + 0.6vw, 1.5rem);
    margin-bottom: 8px;
  }
  .service-body p {
    color: var(--muted);
    font-size: 1rem;
    max-width: 52ch;
  }
  /* The section's single call to action, right-aligned to close the
     list where the rows used to carry it. */
  .services-cta {
    display: flex;
    width: fit-content;
    margin-top: 32px;
    margin-left: auto;
    align-items: center;
    gap: 8px;
    color: var(--muted);
    font-size: 1rem;
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
    transition: color 200ms ease-out;
  }
  .services-cta .arrow {
    transition: transform 200ms ease-out;
  }
  .services-cta:hover {
    color: var(--text);
  }
  .services-cta:hover .arrow {
    transform: translateX(4px);
    color: var(--accent);
  }
  @media (max-width: 768px) {
    .service {
      grid-template-columns: 1fr;
      gap: 12px;
      padding-block: 32px;
    }
  }
</style>
