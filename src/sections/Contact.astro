<!-- HAUTEK contact: plain details one side, minimal form other.
     OWNER: contact details come from src/data/site.ts. Words from
     src/data/content.ts (contact). -->
---
import ContactForm from '../components/ContactForm.astro';
import { site } from '../data/site';
import { contact } from '../data/content';
import whatsappLogo from '../assets/icons/whatsapp.svg?raw';
---

<section id="contact" class="section contact" aria-labelledby="contact-heading">
  <div class="container">
    <p class="eyebrow">{contact.eyebrow}</p>
    <h2 id="contact-heading" class="h2">{contact.heading}</h2>
    <p class="body-copy">{contact.intro}</p>

    <div class="contact-grid">
      <address class="contact-details">
        <a class="detail-email" href={`mailto:${site.email}`}>
          <span class="icon icon-mail" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
          </span>
          {site.email}
        </a>
        <a
          class="detail-tel"
          href={`tel:${site.phones[0].replace(/[^+\d]/g, '')}`}
        >
          <span class="icon icon-phone" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
          </span>
          {site.phones[0]}
        </a>
        <a
          class="detail-wa"
          href={`https://wa.me/${site.phones[0].replace(/[^+\d]/g, '')}`}
          target="_blank"
          rel="noopener noreferrer"
        >
          <span class="icon icon-whatsapp" aria-hidden="true" set:html={whatsappLogo} />
          WhatsApp
        </a>
        {site.location && <span>{site.location}</span>}
      </address>
      <div>
        <ContactForm />
      </div>
    </div>
  </div>
</section>

<style>
  .contact .eyebrow {
    margin-bottom: 24px;
  }
  .contact .h2 {
    max-width: 16ch;
    margin-bottom: 16px;
  }
  .contact .body-copy {
    margin-bottom: 64px;
  }
  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: 80px;
    align-items: start;
  }
  /* Let both columns shrink instead of overflowing the grid. */
  .contact-grid > * {
    min-width: 0;
  }
  .contact-details {
    display: grid;
    gap: 16px;
    font-style: normal;
    font-size: 1.0625rem;
  }
  .detail-email {
    font-size: clamp(1.25rem, 1.1rem + 0.6vw, 1.5rem);
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.01em;
    color: var(--text);
    text-decoration: none;
    justify-self: start; /* hover underline hugs the text, not the column */
    overflow-wrap: anywhere;
  }
  .detail-email:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
    text-decoration-color: var(--accent);
  }
  .contact-details span {
    color: var(--muted);
  }
  .detail-tel,
  .detail-wa {
    justify-self: start;
    color: var(--muted);
    text-decoration: none;
    transition: color 200ms ease-out;
  }
  .detail-tel:hover {
    color: var(--text);
    text-decoration: underline;
    text-underline-offset: 4px;
    text-decoration-color: var(--accent);
  }

  .detail-email,
  .detail-tel,
  .detail-wa {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px; /* touch-friendly tap target */
    overflow-wrap: anywhere;
    white-space: nowrap;
    flex-wrap: nowrap;
    padding: 6px 0;
  }
  .detail-tel:hover,
  .detail-wa:hover {
    color: var(--text);
    text-decoration: underline;
    text-underline-offset: 4px;
    text-decoration-color: var(--accent);
  }
  .icon {
    width: 20px;
    height: 20px;
    flex-shrink: 0;
    color: currentColor;
  }

  @media (max-width: 860px) {
    .contact-grid {
      grid-template-columns: 1fr;
      gap: 48px;
    }
    .detail-email,
    .detail-tel,
    .detail-wa {
      gap: 10px;
    }
    .icon {
      width: 22px;
      height: 22px;
    }
  }
</style>
