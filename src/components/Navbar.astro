<!-- HAUTEK navbar: floating pill bar, wordmark left, links centered,
     contact button right. OWNER: links come from src/data/site.ts. Mobile
     menu is a <details> element: HTML and CSS only, keyboard accessible,
     no JavaScript. -->
---
import Brand from './Brand.astro';
import { site } from '../data/site';
---

<header class="navbar">
  <div class="navbar-bar">
    <a class="brand" href="#top" aria-label={`${site.name} home`}>
      <Brand />
    </a>

    <nav class="links" aria-label="Primary">
      {
        site.nav.map((item) => (
          <a class="nav-link" href={item.href}>
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="actions">
      <a class="btn btn-dark btn-nav" href="#contact">
        Start a project
      </a>

      <!-- Mobile menu: <details> gives open/close + keyboard + no-JS free. -->
      <details class="menu">
        <summary class="menu-button" aria-label="Open menu">
          <span class="menu-icon" aria-hidden="true">
            <span></span>
            <span></span>
          </span>
          <span class="sr-only">Menu</span>
        </summary>
        <div class="menu-panel">
          <nav aria-label="Mobile">
            {
              site.nav.map((item) => (
                <a class="menu-link" href={item.href}>
                  {item.label}
                </a>
              ))
            }
            <a class="btn btn-dark" href="#contact">
              Start a project
            </a>
          </nav>
        </div>
      </details>
    </div>
  </div>
</header>

<style>
  /* Floating glass pill: sticky with a 12px offset, page scrolls
     beneath it. The glass is built in layers: the --nav-bg tint at
     the bottom, a diagonal white sheen above it, a white hairline
     border and an inset top highlight that catches the light. Blur
     and saturation make the photo melt behind the bar. */
  .navbar {
    position: sticky;
    top: 12px;
    z-index: 50;
    padding-inline: 24px;
  }
  .navbar-bar {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 24px;
    max-width: 1200px;
    height: 64px;
    margin-inline: auto;
    padding-inline: 24px;
    background:
      linear-gradient(
        115deg,
        rgb(255 255 255 / 0.4),
        rgb(255 255 255 / 0.06) 55%,
        rgb(255 255 255 / 0.28)
      ),
      var(--nav-bg);
    border: 1px solid rgb(255 255 255 / 0.55);
    border-radius: 9999px;
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.55),
      0 12px 40px var(--bar-shadow);
    -webkit-backdrop-filter: blur(24px) saturate(180%);
    backdrop-filter: blur(24px) saturate(180%);
  }
  .brand {
    display: inline-flex;
    justify-self: start;
    color: var(--text);
    text-decoration: none;
  }
  .links {
    display: flex;
    align-items: center;
    justify-self: center;
    gap: 32px;
  }
  .nav-link {
    position: relative;
    color: var(--muted);
    font-size: 0.9375rem;
    font-weight: 400;
    text-decoration: none;
    padding-block: 8px;
    transition: color 200ms ease-out;
  }
  .nav-link:hover {
    color: var(--text);
  }
  .nav-link::after {
    content: '';
    position: absolute;
    left: 0;
    right: 100%;
    bottom: 2px;
    height: 1px;
    background: var(--accent);
    transition: right 200ms ease-out;
  }
  .nav-link:hover::after {
    right: 0;
  }
  .actions {
    display: flex;
    align-items: center;
    justify-self: end;
    gap: 16px;
  }
  /* Navy button, like the reference's dark button: quiet and solid. */
  .btn-dark {
    background: var(--accent);
    color: var(--accent-ink);
  }
  .btn-dark:hover {
    background: var(--accent-hover);
  }
  .btn-nav {
    min-height: 44px;
    padding: 0 20px;
    font-size: 0.9375rem;
  }

  /* Mobile menu (details/popover-free, pure HTML+CSS). */
  .menu {
    display: none;
    position: relative;
  }
  .menu-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px; /* 44px: the minimum comfortable tap target */
    border: 1px solid var(--border);
    border-radius: 9999px;
    cursor: pointer;
    list-style: none;
    color: var(--text);
  }
  .menu-button::-webkit-details-marker {
    display: none;
  }
  .menu-button:hover {
    border-color: var(--muted);
  }
  .menu-icon {
    display: grid;
    gap: 6px;
  }
  .menu-icon span {
    display: block;
    width: 18px;
    height: 1.5px;
    background: currentColor;
    transition: transform 200ms ease-out;
  }
  .menu[open] .menu-icon span:first-child {
    transform: translateY(3.75px) rotate(45deg);
  }
  .menu[open] .menu-icon span:last-child {
    transform: translateY(-3.75px) rotate(-45deg);
  }
  .menu-panel {
    position: absolute;
    right: 0;
    top: calc(100% + 12px);
    min-width: 240px;
    padding: 16px;
    /* Same glass as the bar: tint, sheen, hairline, highlight. */
    background:
      linear-gradient(
        160deg,
        rgb(255 255 255 / 0.35),
        rgb(255 255 255 / 0.08)
      ),
      var(--nav-bg);
    border: 1px solid rgb(255 255 255 / 0.5);
    border-radius: 12px;
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.5),
      0 12px 40px var(--bar-shadow);
    -webkit-backdrop-filter: blur(24px) saturate(180%);
    backdrop-filter: blur(24px) saturate(180%);
    /* Enters from the button that triggered it: fade and a 4px drop
       toward the page. Closing snaps: <details> unrenders content and
       CSS has no reverse hook here without restructuring the layout. */
    opacity: 0;
    transform: translateY(-4px);
    transition:
      opacity 150ms ease-out,
      transform 150ms ease-out;
  }
  .menu[open] .menu-panel {
    opacity: 1;
    transform: translateY(0);
  }
  .menu-panel nav {
    display: grid;
    gap: 4px;
  }
  .menu-link {
    padding: 12px;
    border-radius: 8px;
    color: var(--text);
    text-decoration: none;
    font-size: 1rem;
  }
  .menu-link:hover {
    background: var(--bg-alt);
  }
  .menu-panel .btn {
    margin-top: 8px;
    width: 100%;
  }

  @media (max-width: 860px) {
    .navbar {
      padding-inline: 16px;
    }
    .links,
    .btn-nav {
      display: none;
    }
    .menu {
      display: block;
    }
  }

  /* No backdrop-filter support (older Firefox, some WebViews): the
     translucent glass would sit thin over the photo, so fall back to
     a solid surface instead of shipping hard-to-read chrome. */
  @supports not (
    (backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))
  ) {
    .navbar-bar,
    .menu-panel {
      background: var(--surface);
      border-color: var(--border);
      box-shadow: 0 12px 40px var(--bar-shadow);
    }
  }
</style>
