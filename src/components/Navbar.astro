<!-- HAUTEK navbar: floating pill bar, wordmark left, links centered,
     contact button right. OWNER: links come from src/data/site.ts. Mobile
     menu is a <details> element: HTML and CSS only, keyboard accessible,
     no JavaScript. -->
---
import Brand from './Brand.astro';
import { site } from '../data/site';
---

<header class="navbar">
  <div class="navbar-bar">
    <a class="brand" href="/#top" aria-label={`${site.name} home`}>
      <Brand />
    </a>

    <nav class="links" aria-label="Primary">
      {
        site.nav.map((item) => (
          <a class="nav-link" href={item.href}>
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="actions">
      <a class="btn btn-dark btn-nav" href="/#contact">
        Start a project
      </a>

      <!-- Mobile menu: animated disclosure with reliable close-on-select. -->
      <div class="menu" data-menu-root>
        <button
          class="menu-button"
          type="button"
          aria-label="Open menu"
          aria-expanded="false"
          aria-controls="mobile-menu-panel"
        >
          <span class="menu-icon" aria-hidden="true">
            <span></span>
            <span></span>
          </span>
          <span class="sr-only">Menu</span>
        </button>
        <div class="menu-panel" id="mobile-menu-panel" hidden>
          <nav aria-label="Mobile">
            {
              site.nav.map((item) => (
                <a class="menu-link" href={item.href}>
                  {item.label}
                </a>
              ))
            }
            <a class="btn btn-dark menu-cta" href="/#contact">
              Start a project
            </a>
          </nav>
        </div>
      </div>
    </div>
  </div>
</header>

<script>
  /* Mobile menu: accessible, animated disclosure with reliable close behavior. */
  (() => {
    const root = document.querySelector('[data-menu-root]');
    if (!(root instanceof HTMLElement)) return;

    const button = root.querySelector('.menu-button');
    const panel = root.querySelector('.menu-panel');
    const links = root.querySelectorAll('a');

    if (!(button instanceof HTMLButtonElement) || !(panel instanceof HTMLElement)) return;

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    let isOpen = false;
    let closeTimer: number | undefined;

    const clearCloseTimer = () => {
      if (closeTimer !== undefined) {
        window.clearTimeout(closeTimer);
        closeTimer = undefined;
      }
    };

    const finishClose = () => {
      panel.hidden = true;
      panel.classList.remove('is-closing');
    };

    const setOpenState = (open: boolean) => {
      isOpen = open;
      root.classList.toggle('is-open', open);
      button.setAttribute('aria-expanded', open ? 'true' : 'false');
      button.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    };

    const openMenu = () => {
      clearCloseTimer();
      panel.hidden = false;
      panel.classList.remove('is-closing');

      // Ensure the opening transition can run from the closed state.
      requestAnimationFrame(() => {
        setOpenState(true);
      });
    };

    const closeMenu = (options?: { restoreFocus?: boolean }) => {
      if (!isOpen && panel.hidden) return;

      clearCloseTimer();
      setOpenState(false);

      if (reduceMotion.matches) {
        finishClose();
      } else {
        panel.classList.add('is-closing');
        closeTimer = window.setTimeout(finishClose, 220);
      }

      if (options?.restoreFocus) {
        button.focus();
      }
    };

    button.addEventListener('click', () => {
      if (isOpen) closeMenu();
      else openMenu();
    });

    links.forEach((link) => {
      link.addEventListener('click', () => {
        // Close immediately so the menu never blocks content after selection.
        closeMenu();
      });
    });

    document.addEventListener('click', (event) => {
      if (!isOpen) return;
      const target = event.target;
      if (target instanceof Node && !root.contains(target)) {
        closeMenu();
      }
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && isOpen) {
        event.preventDefault();
        closeMenu({ restoreFocus: true });
      }
    });

    window.addEventListener('resize', () => {
      if (window.innerWidth > 860 && isOpen) {
        clearCloseTimer();
        setOpenState(false);
        finishClose();
      }
    });

    // If the page is restored from bfcache, ensure the menu is not left open.
    window.addEventListener('pageshow', () => {
      if (isOpen) {
        clearCloseTimer();
        setOpenState(false);
        finishClose();
      }
    });
  })();
</script>

<style>
  /* Floating glass pill: sticky with a 12px offset, page scrolls
     beneath it. The glass is built in layers: the --nav-bg tint at
     the bottom, a diagonal white sheen above it, a white hairline
     border, inset top and bottom glows that catch the light, and a
     specular streak lying across the bar like a reflection. Strong
     blur and saturation melt the photo behind the glass. */
  .navbar {
    position: sticky;
    top: 12px;
    z-index: 50;
    padding-inline: 24px;
  }
  .navbar-bar {
    position: relative;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 24px;
    max-width: 1200px;
    height: 64px;
    margin-inline: auto;
    padding-inline: 24px;
    background:
      linear-gradient(
        115deg,
        rgb(255 255 255 / 0.4),
        rgb(255 255 255 / 0.06) 55%,
        rgb(255 255 255 / 0.28)
      ),
      var(--nav-bg);
    border: 1px solid rgb(255 255 255 / 0.65);
    border-radius: 9999px;
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.6),
      inset 0 -1px 0 rgb(255 255 255 / 0.2),
      inset 0 0 24px rgb(255 255 255 / 0.12),
      0 12px 40px var(--bar-shadow);
    -webkit-backdrop-filter: blur(28px) saturate(200%);
    backdrop-filter: blur(28px) saturate(200%);
  }
  /* The liquid streak: a soft band of light sweeping across the pill,
     which reads as curvature in the glass. Real content sits above it
     so link contrast never passes through the highlight. */
  .navbar-bar::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: linear-gradient(
      100deg,
      transparent 18%,
      rgb(255 255 255 / 0.35) 42%,
      rgb(255 255 255 / 0.04) 60%,
      transparent 80%
    );
    pointer-events: none;
  }
  .navbar-bar > * {
    position: relative;
  }
  .brand {
    display: inline-flex;
    justify-self: start;
    color: var(--text);
    text-decoration: none;
  }
  .links {
    display: flex;
    align-items: center;
    justify-self: center;
    gap: 32px;
  }
  .nav-link {
    position: relative;
    color: var(--muted);
    font-size: 0.9375rem;
    font-weight: 400;
    text-decoration: none;
    padding-block: 8px;
    transition: color var(--dur-base, 220ms) var(--ease-out, cubic-bezier(0.16, 1, 0.3, 1));
  }
  .nav-link:hover {
    color: var(--text);
  }
  .nav-link::after {
    content: '';
    position: absolute;
    left: 0;
    right: 100%;
    bottom: 2px;
    height: 1px;
    background: var(--accent);
    transition: right var(--dur-base, 220ms) var(--ease-out, cubic-bezier(0.16, 1, 0.3, 1));
  }
  .nav-link:hover::after {
    right: 0;
  }
  .actions {
    display: flex;
    align-items: center;
    justify-self: end;
    gap: 16px;
  }
  /* Navy button, like the reference's dark button: quiet and solid. */
  .btn-dark {
    background: var(--accent);
    color: var(--accent-ink);
  }
  .btn-dark:hover {
    background: var(--accent-hover);
  }
  .btn-nav {
    min-height: 44px;
    padding: 0 20px;
    font-size: 0.9375rem;
  }

  /* Mobile menu: animated, accessible disclosure. */
  .menu {
    display: none;
    position: relative;
  }
  .menu-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px; /* 44px: comfortable tap target */
    padding: 0;
    border: 1px solid var(--border);
    border-radius: 9999px;
    background: transparent;
    cursor: pointer;
    color: var(--text);
    transition:
      border-color var(--dur-base, 220ms) var(--ease-out, cubic-bezier(0.16, 1, 0.3, 1)),
      background-color var(--dur-base, 220ms) var(--ease-out, cubic-bezier(0.16, 1, 0.3, 1)),
      color var(--dur-base, 220ms) var(--ease-out, cubic-bezier(0.16, 1, 0.3, 1)),
      transform var(--dur-fast, 150ms) var(--ease-out, cubic-bezier(0.16, 1, 0.3, 1));
  }
  .menu-button:hover {
    border-color: var(--muted);
    background: rgb(255 255 255 / 0.24);
  }
  .menu-button:active {
    transform: scale(0.97);
  }
  .menu.is-open .menu-button {
    border-color: var(--muted);
    background: rgb(255 255 255 / 0.3);
  }
  .menu-icon {
    display: grid;
    gap: 6px;
  }
  .menu-icon span {
    display: block;
    width: 18px;
    height: 1.5px;
    border-radius: 999px;
    background: currentColor;
    transform-origin: center;
    transition: transform var(--dur-base, 220ms) var(--ease-out, cubic-bezier(0.16, 1, 0.3, 1));
  }
  .menu.is-open .menu-icon span:first-child {
    transform: translateY(3.75px) rotate(45deg);
  }
  .menu.is-open .menu-icon span:last-child {
    transform: translateY(-3.75px) rotate(-45deg);
  }
  .menu-panel {
    position: absolute;
    right: 0;
    top: calc(100% + 12px);
    min-width: min(280px, calc(100vw - 32px));
    padding: 12px;
    /* Same glass language as the navbar bar. */
    background:
      linear-gradient(
        160deg,
        rgb(255 255 255 / 0.38),
        rgb(255 255 255 / 0.1)
      ),
      var(--nav-bg);
    border: 1px solid rgb(255 255 255 / 0.62);
    border-radius: 16px;
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.5),
      inset 0 0 16px rgb(255 255 255 / 0.1),
      0 16px 48px rgb(10 25 49 / 0.14);
    -webkit-backdrop-filter: blur(28px) saturate(200%);
    backdrop-filter: blur(28px) saturate(200%);
    opacity: 0;
    transform: translateY(-8px) scale(0.985);
    transform-origin: top right;
    visibility: hidden;
    pointer-events: none;
    transition:
      opacity var(--dur-base, 220ms) var(--ease-out, cubic-bezier(0.16, 1, 0.3, 1)),
      transform var(--dur-base, 220ms) var(--ease-out, cubic-bezier(0.16, 1, 0.3, 1)),
      visibility 0s linear var(--dur-base, 220ms);
    will-change: opacity, transform;
  }
  .menu-panel[hidden] {
    display: none;
  }
  .menu.is-open .menu-panel {
    opacity: 1;
    transform: translateY(0) scale(1);
    visibility: visible;
    pointer-events: auto;
    transition-delay: 0s;
  }
  .menu-panel nav {
    display: grid;
    gap: 4px;
  }
  .menu-link {
    display: flex;
    align-items: center;
    min-height: 44px;
    padding: 10px 12px;
    border-radius: 10px;
    color: var(--text);
    text-decoration: none;
    font-size: 1rem;
    line-height: 1.4;
    transition:
      background-color var(--dur-fast, 150ms) var(--ease-out, cubic-bezier(0.16, 1, 0.3, 1)),
      color var(--dur-fast, 150ms) var(--ease-out, cubic-bezier(0.16, 1, 0.3, 1)),
      transform var(--dur-fast, 150ms) var(--ease-out, cubic-bezier(0.16, 1, 0.3, 1));
  }
  .menu-link:hover {
    background: rgb(255 255 255 / 0.45);
  }
  .menu-link:active {
    transform: scale(0.99);
  }
  .menu-panel .btn {
    margin-top: 8px;
    width: 100%;
  }

  @media (max-width: 860px) {
    .navbar {
      padding-inline: 16px;
    }
    /* Switch to flex on mobile so brand sits left and menu sits right. */
    .navbar-bar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 16px;
    }
    .links,
    .btn-nav {
      display: none;
    }
    .menu {
      display: block;
    }
  }

  /* No backdrop-filter support (older Firefox, some WebViews): the
     translucent glass would sit thin over the photo, so fall back to
     a solid surface instead of shipping hard-to-read chrome. */
  @supports not (
    (backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))
  ) {
    .navbar-bar,
    .menu-panel {
      background: var(--surface);
      border-color: var(--border);
      box-shadow: 0 12px 40px var(--bar-shadow);
    }
    /* The streak is part of the glass; hide it on the solid fallback. */
    .navbar-bar::before {
      display: none;
    }
  }
</style>
