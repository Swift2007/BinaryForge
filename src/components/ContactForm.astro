<!-- BinaryForge contact form. Plain HTML, browser validation only.
     OWNER: add your form endpoint in src/data/site.ts. Until then the
     form shows a notice instead of sending. Field words live in
     src/data/content.ts (contact.form). No JavaScript validation. -->
---
import { site } from '../data/site';
import { contact } from '../data/content';

const hasEndpoint = site.formEndpoint.length > 0;
const f = contact.form;
---

<form
  class="form"
  action={hasEndpoint ? site.formEndpoint : undefined}
  method="POST"
  aria-label="Contact form"
>
      <div class="field">
        <label class="sr-only" for="cf-first">
          {f.firstNameLabel}
        </label>
        <input
          id="cf-first"
          name="firstName"
          type="text"
          autocomplete="given-name"
          placeholder={f.firstNamePlaceholder}
          required
        />
      </div>
      <div class="field">
        <label class="sr-only" for="cf-surname">
          {f.surnameLabel}
        </label>
        <input
          id="cf-surname"
          name="surname"
          type="text"
          autocomplete="family-name"
          placeholder={f.surnamePlaceholder}
          required
        />
      </div>
      <div class="field">
        <label class="sr-only" for="cf-email">
          {f.emailLabel}
        </label>
        <input
          id="cf-email"
          name="email"
          type="email"
          autocomplete="email"
          placeholder={f.emailPlaceholder}
          required
        />
      </div>
      <div class="field">
        <label class="sr-only" for="cf-phone">
          {f.phoneLabel}
        </label>
        <input
          id="cf-phone"
          name="phone"
          type="tel"
          autocomplete="tel"
          placeholder={f.phonePlaceholder}
        />
      </div>
      <div class="field field-full">
        <label class="sr-only" for="cf-message">
          {f.messageLabel}
        </label>
        <textarea
          id="cf-message"
          name="message"
          rows="5"
          placeholder={f.messagePlaceholder}
          required
        />
      </div>
      <label class="consent">
        <input type="checkbox" name="consent" required />
        <span>{f.consent}</span>
      </label>
      <button class="btn btn-primary form-submit" type="submit">
        {f.submit}
      </button>
    </form>
{
  /* Visible until the owner adds a form endpoint in site.ts. */
  !hasEndpoint && (
    <p class="form-note">
      {f.note}{' '}
      <a class="prose-link" href={`mailto:${site.email}`}>
        {site.email}
      </a>
    </p>
  )
}

<style>
  /* Two-column form like the reference: pairs side by side,
     message, consent and submit full width. */
  .form {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }
  .field {
    display: grid;
  }
  .field-full,
  .consent,
  .form-submit {
    grid-column: 1 / -1;
  }
  .field input,
  .field textarea {
    width: 100%;
    min-width: 0;
    font: inherit;
    font-size: 1rem;
    color: var(--text);
    background: var(--input-bg);
    border: 1px solid var(--border);
    transition:
      border-color 150ms ease-out,
      box-shadow 150ms ease-out;
  }
  .field input {
    height: 60px;
    padding: 0 24px;
    border-radius: 999px;
  }
  .field textarea {
    min-height: 150px;
    padding: 20px 24px;
    border-radius: 24px;
    resize: vertical;
    line-height: 1.6;
  }
  .field input::placeholder,
  .field textarea::placeholder {
    color: var(--muted);
    opacity: 0.8;
  }
  .field input:hover,
  .field textarea:hover {
    border-color: var(--muted);
  }
  .field input:focus,
  .field textarea:focus {
    outline: none;
    border-color: var(--accent);
    box-shadow: 0 0 0 3px var(--ring-soft);
  }
  /* Consent row: native checkbox tinted to the theme. */
  .consent {
    display: flex;
    gap: 12px;
    align-items: flex-start;
    margin-top: 4px;
    font-size: 0.9375rem;
    line-height: 1.55;
    color: var(--muted);
    cursor: pointer;
  }
  .consent input {
    flex: none;
    width: 20px;
    height: 20px;
    margin-top: 2px;
    accent-color: var(--accent);
  }
  .form-submit {
    width: 100%;
    margin-top: 8px;
  }
  /* Shown until the owner adds a form endpoint in site.ts. */
  .form-note {
    margin-top: 16px;
    font-size: 0.9375rem;
    color: var(--muted);
  }
  @media (max-width: 640px) {
    .form {
      grid-template-columns: 1fr;
    }
  }
</style>
