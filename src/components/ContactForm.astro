<!-- BinaryForge contact form. Plain HTML, browser validation only,
     no JavaScript: Web3Forms POSTs and redirects to /sent/.
     OWNER: paste the Web3Forms access key in src/data/site.ts. Until
     the key is set the form uses a mailto action, so Send opens the
     visitor's email app with the message composed instead of posting
     to nowhere. Field words live in src/data/content.ts
     (contact.form). -->
---
import { site } from '../data/site';
import { contact } from '../data/content';

// The form posts to Web3Forms only when it is fully configured: the
// endpoint plus the access key. Until then the mailto fallback keeps
// Send working as something real instead of landing on an API error.
const isReady = site.formEndpoint.length > 0 && site.accessKey.length > 0;
const f = contact.form;
---

<form
  class="form"
  action={isReady ? site.formEndpoint : `mailto:${site.email}`}
  enctype={isReady ? undefined : 'text/plain'}
  method="POST"
  aria-label="Contact form"
>
  {isReady && (
    <>
      <input type="hidden" name="access_key" value={site.accessKey} />
      <input
        type="hidden"
        name="subject"
        value={`New message from the ${site.name} website`}
      />
      <input
        type="hidden"
        name="redirect"
        value={`${site.canonical.replace(/\/$/, '')}/sent/`}
      />
    </>
  )}
  {/* Honeypot per the Web3Forms pattern: invisible and unfocusable,
      but still submitted unchecked. Bots that fill it are dropped. */}
  <input
    type="checkbox"
    name="botcheck"
    hidden
    tabindex="-1"
    aria-hidden="true"
  />
      <div class="field">
        <label class="sr-only" for="cf-first">
          {f.firstNameLabel}
        </label>
        <input
          id="cf-first"
          name="firstName"
          type="text"
          autocomplete="given-name"
          placeholder={f.firstNamePlaceholder}
          required
        />
      </div>
      <div class="field">
        <label class="sr-only" for="cf-surname">
          {f.surnameLabel}
        </label>
        <input
          id="cf-surname"
          name="surname"
          type="text"
          autocomplete="family-name"
          placeholder={f.surnamePlaceholder}
          required
        />
      </div>
      <div class="field">
        <label class="sr-only" for="cf-email">
          {f.emailLabel}
        </label>
        <input
          id="cf-email"
          name="email"
          type="email"
          autocomplete="email"
          placeholder={f.emailPlaceholder}
          required
        />
      </div>
      <div class="field">
        <label class="sr-only" for="cf-phone">
          {f.phoneLabel}
        </label>
        <input
          id="cf-phone"
          name="phone"
          type="tel"
          autocomplete="tel"
          placeholder={f.phonePlaceholder}
        />
      </div>
      <div class="field field-full">
        <label class="sr-only" for="cf-message">
          {f.messageLabel}
        </label>
        <textarea
          id="cf-message"
          name="message"
          rows="5"
          placeholder={f.messagePlaceholder}
          required
        />
      </div>
      <label class="consent">
        <input type="checkbox" name="consent" required />
        <span>{f.consent}</span>
      </label>
      <button class="btn btn-primary form-submit" type="submit">
        {f.submit}
      </button>
    </form>
{
  /* Visible until the owner pastes the Web3Forms key in site.ts. */
  !isReady && (
    <p class="form-note">
      {f.note}{' '}
      <a class="prose-link" href={`mailto:${site.email}`}>
        {site.email}
      </a>
    </p>
  )
}

<style>
  /* Two-column form like the reference: pairs side by side,
     message, consent and submit full width. */
  .form {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }
  .field {
    display: grid;
  }
  .field-full,
  .consent,
  .form-submit {
    grid-column: 1 / -1;
  }
  .field input,
  .field textarea {
    width: 100%;
    min-width: 0;
    font: inherit;
    font-size: 1rem;
    color: var(--text);
    background: var(--input-bg);
    border: 1px solid var(--border);
    transition:
      border-color 150ms ease-out,
      box-shadow 150ms ease-out;
  }
  /* 8px radius and 52px height match the button system, so fields and
     the submit button read as one set of parts instead of a mix. */
  .field input {
    height: 52px;
    padding: 0 16px;
    border-radius: 8px;
  }
  .field textarea {
    min-height: 140px;
    padding: 16px;
    border-radius: 8px;
    resize: vertical;
    line-height: 1.6;
  }
  .field input::placeholder,
  .field textarea::placeholder {
    /* Full opacity: 0.8 lands near 4.4:1 on white, below AA. */
    color: var(--muted);
  }
  .field input:hover,
  .field textarea:hover {
    border-color: var(--muted);
  }
  .field input:focus,
  .field textarea:focus {
    outline: none;
    border-color: var(--accent);
    box-shadow: 0 0 0 3px var(--ring-soft);
  }
  /* Consent row: native checkbox tinted to the theme. */
  .consent {
    display: flex;
    gap: 12px;
    align-items: flex-start;
    margin-top: 4px;
    font-size: 0.9375rem;
    line-height: 1.55;
    color: var(--muted);
    cursor: pointer;
  }
  .consent input {
    flex: none;
    width: 20px;
    height: 20px;
    margin-top: 2px;
    accent-color: var(--accent);
  }
  .form-submit {
    width: 100%;
    margin-top: 8px;
  }
  /* Shown until the owner adds a form endpoint in site.ts. */
  .form-note {
    margin-top: 16px;
    font-size: 0.9375rem;
    color: var(--muted);
  }
  @media (max-width: 640px) {
    .form {
      grid-template-columns: 1fr;
    }
  }
</style>
