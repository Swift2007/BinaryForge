<!-- HAUTEK footer: contained ink card with link columns and a
     giant cropped wordmark. OWNER: links come from src/data/site.ts
     (nav, contact, socials) and src/data/content.ts (services, footer). -->
---
import Brand from './Brand.astro';
import { site } from '../data/site';
import { services, footer } from '../data/content';
import whatsappLogo from '../assets/icons/whatsapp.svg?raw';
---

<footer class="footer">
  <div class="footer-card">
    <div class="footer-top">
      <div class="footer-brand">
        <a href="/#top" aria-label={`${site.name} home`}>
          <Brand variant="light" />
        </a>
        <p>{footer.note}</p>
      </div>

      <nav class="footer-col" aria-label="Services">
        <h2 class="footer-heading">Services</h2>
        {
          services.items.map((s) => (
            <a href={`/#${s.id}`}>{s.title}</a>
          ))
        }
      </nav>

      <nav class="footer-col" aria-label="Company">
        <h2 class="footer-heading">Company</h2>
        {
          site.nav.map((item) => (
            <a href={item.href}>{item.label}</a>
          ))
        }
      </nav>

      <div class="footer-col">
        <h2 class="footer-heading">Contact</h2>
        <a href={`mailto:${site.email}`} class="contact-link">
          <span class="icon icon-mail" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
          </span>
          {site.email}
        </a>
        <a
          href={`tel:${site.phones[0].replace(/[^+\d]/g, '')}`}
          class="contact-link contact-tel"
        >
          <span class="icon icon-phone" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
          </span>
          {site.phones[0]}
        </a>
        <a
          href={`https://wa.me/${site.phones[0].replace(/[^+\d]/g, '')}`}
          class="contact-link contact-wa"
          target="_blank"
          rel="noopener noreferrer"
        >
          <span class="icon icon-whatsapp" aria-hidden="true" set:html={whatsappLogo} />
          WhatsApp
        </a>
        <span>{site.location}</span>
      </div>

      {
        /* Rendered only once real profile URLs exist in site.ts, so the
           footer never shows links that go nowhere. */
        site.socials.length > 0 && (
          <nav class="footer-col" aria-label="Social">
            <h2 class="footer-heading">Social</h2>
            {site.socials.map((s) => (
              <a href={s.href} rel="noopener noreferrer">
                {s.label}
              </a>
            ))}
          </nav>
        )
      }
    </div>

    <div class="footer-base">
      <p>{footer.rights}</p>
      <nav class="footer-legal" aria-label="Legal">
        <a href="/terms">Terms and Conditions</a>
        <a href="/privacy">Privacy Policy</a>
      </nav>
      <a class="to-top" href="#top">Back to top</a>
    </div>

    <div class="footer-wordmark" aria-hidden="true">
      <img
        class="wordmark"
        src="/hautek-logo-white.png"
        alt=""
        width="1000"
        height="300"
      />
    </div>
  </div>
</footer>

<style>
  .footer {
    padding: 0 24px 24px;
  }
  /* Contained dark card: the footer's whole identity. */
  .footer-card {
    max-width: 1200px;
    margin-inline: auto;
    padding: 64px 64px 0;
    overflow: hidden;
    background: var(--card);
    border-radius: 24px;
  }
  /* Brand column, then one track per link group. If the Social column
     returns (see site.ts), add a track back here. */
  .footer-top {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr 1fr;
    gap: 48px;
    align-items: start;
  }
  .footer-brand {
    display: grid;
    gap: 16px;
    justify-items: start;
    color: var(--on-dark); /* the wordmark inherits this */
  }
  .footer-brand p {
    color: var(--on-dark-muted);
    font-size: 0.9375rem;
    max-width: 30ch;
  }
  .footer-col {
    display: grid;
    gap: 12px;
    align-content: start;
    font-size: 0.9375rem;
  }
  .footer-heading {
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--on-dark-muted);
    margin-bottom: 4px;
  }
  .footer-col a {
    color: var(--on-dark-muted);
    text-decoration: none;
    transition: color var(--dur-base, 220ms) var(--ease-out, cubic-bezier(0.16, 1, 0.3, 1));
  }
  .footer-col a:hover {
    color: var(--on-dark);
  }
  .footer-col span {
    color: var(--on-dark-muted);
  }
  .footer-base {
    display: flex;
    flex-wrap: wrap;
    gap: 16px 32px;
    align-items: center;
    justify-content: space-between;
    margin-top: 48px;
    padding-top: 24px;
    border-top: 1px solid var(--card-line);
  }
  .footer-base p {
    color: var(--on-dark-muted);
    font-size: 0.875rem;
  }
  .to-top {
    color: var(--on-dark-muted);
    font-size: 0.875rem;
    text-decoration: none;
  }
  .to-top:hover {
    color: var(--on-dark);
  }
  .footer-legal {
    display: flex;
    gap: 24px;
    font-size: 0.875rem;
  }
  .footer-legal a {
    color: var(--on-dark-muted);
    text-decoration: none;
    transition: color var(--dur-base, 220ms) var(--ease-out, cubic-bezier(0.16, 1, 0.3, 1));
  }
  .footer-legal a:hover {
    color: var(--on-dark);
  }
  /* Focus ring scoped to the card: the global ring is --focus-ring
     (logo blue #0d3b66), which is 1.53:1 on this ink background and
     effectively invisible to keyboard users. White keeps the global
     2px/3px-offset geometry and reads at 17.55:1 here. */
  .footer-card :where(a):focus-visible {
    outline-color: var(--on-dark);
  }
  /* Giant wordmark cropped by the card edge, fading as it goes.
     The mask was removed because mask-image forces recompositing on
     every paint during scroll, causing jank on long pages. */
  .footer-wordmark {
    margin-top: 40px;
    padding-bottom: 40px;
    user-select: none;
    display: flex;
    justify-content: center;
  }
  .wordmark {
    width: min(100%, 600px);
    height: auto;
    margin-bottom: 0;
    will-change: transform;
  }
  @media (max-width: 1024px) {
    .footer-top {
      grid-template-columns: 1fr 1fr 1fr;
      gap: 32px;
    }
    .footer-brand {
      grid-column: 1 / -1;
    }
  }

  .contact-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px; /* touch-friendly tap target */
    overflow-wrap: anywhere;
    white-space: nowrap;
    flex-wrap: nowrap;
    padding: 6px 0;
  }
  .contact-link:hover {
    color: var(--on-dark);
  }
  .icon {
    width: 20px;
    height: 20px;
    flex-shrink: 0;
    color: currentColor;
  }

  @media (max-width: 640px) {
    .footer {
      padding: 0 16px 16px;
    }
    .footer-card {
      padding: 48px 24px 0;
      border-radius: 20px;
    }
    .footer-top {
      grid-template-columns: 1fr 1fr;
    }
    /* Center the brand (logo + note) across both columns on mobile. */
    .footer-brand {
      grid-column: 1 / -1;
      justify-items: center;
      text-align: center;
    }
    .contact-link {
      gap: 10px;
    }
    .icon {
      width: 22px;
      height: 22px;
    }
  }
</style>
