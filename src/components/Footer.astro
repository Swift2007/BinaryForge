<!-- HAUTEK footer: contained ink card with link columns and a
     giant cropped wordmark. OWNER: links come from src/data/site.ts
     (nav, contact, socials) and src/data/content.ts (services, footer). -->
---
import Brand from './Brand.astro';
import { site } from '../data/site';
import { services, footer } from '../data/content';
---

<footer class="footer">
  <div class="footer-card">
    <div class="footer-top">
      <div class="footer-brand">
        <a href="#top" aria-label={`${site.name} home`}>
          <Brand />
        </a>
        <p>{footer.note}</p>
      </div>

      <nav class="footer-col" aria-label="Services">
        <h2 class="footer-heading">Services</h2>
        {
          services.items.map((s) => (
            <a href={`#${s.id}`}>{s.title}</a>
          ))
        }
      </nav>

      <nav class="footer-col" aria-label="Company">
        <h2 class="footer-heading">Company</h2>
        {
          site.nav.map((item) => (
            <a href={item.href}>{item.label}</a>
          ))
        }
      </nav>

      <div class="footer-col">
        <h2 class="footer-heading">Contact</h2>
        <a href={`mailto:${site.email}`}>{site.email}</a>
        {site.phones.map((phone) => (
          <a class="footer-tel" href={`tel:${phone.replace(/[^+\d]/g, '')}`}>
            {phone}
          </a>
        ))}
        <span>{site.location}</span>
      </div>

      {
        /* Rendered only once real profile URLs exist in site.ts, so the
           footer never shows links that go nowhere. */
        site.socials.length > 0 && (
          <nav class="footer-col" aria-label="Social">
            <h2 class="footer-heading">Social</h2>
            {site.socials.map((s) => (
              <a href={s.href} rel="noopener noreferrer">
                {s.label}
              </a>
            ))}
          </nav>
        )
      }
    </div>

    <div class="footer-base">
      <p>{footer.rights}</p>
      <nav class="footer-legal" aria-label="Legal">
        <a href="/terms">Terms and Conditions</a>
        <a href="/privacy">Privacy Policy</a>
      </nav>
      <a class="to-top" href="#top">Back to top</a>
    </div>

    <div class="footer-wordmark" aria-hidden="true">
      <p class="wordmark">{site.name}</p>
    </div>
  </div>
</footer>

<style>
  .footer {
    padding: 0 24px 24px;
  }
  /* Contained dark card: the footer's whole identity. */
  .footer-card {
    max-width: 1200px;
    margin-inline: auto;
    padding: 64px 64px 0;
    overflow: hidden;
    background: var(--card);
    border-radius: 24px;
  }
  /* Brand column, then one track per link group. If the Social column
     returns (see site.ts), add a track back here. */
  .footer-top {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr 1fr;
    gap: 48px;
    align-items: start;
  }
  .footer-brand {
    display: grid;
    gap: 16px;
    justify-items: start;
    color: var(--on-dark); /* the wordmark inherits this */
  }
  .footer-brand p {
    color: var(--on-dark-muted);
    font-size: 0.9375rem;
    max-width: 30ch;
  }
  .footer-col {
    display: grid;
    gap: 12px;
    align-content: start;
    font-size: 0.9375rem;
  }
  .footer-heading {
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--on-dark-muted);
    margin-bottom: 4px;
  }
  .footer-col a {
    color: var(--on-dark-muted);
    text-decoration: none;
    transition: color 200ms ease-out;
  }
  .footer-col a:hover {
    color: var(--on-dark);
  }
  .footer-col span {
    color: var(--on-dark-muted);
  }
  .footer-base {
    display: flex;
    flex-wrap: wrap;
    gap: 16px 32px;
    align-items: center;
    justify-content: space-between;
    margin-top: 48px;
    padding-top: 24px;
    border-top: 1px solid var(--card-line);
  }
  .footer-base p {
    color: var(--on-dark-muted);
    font-size: 0.875rem;
  }
  .to-top {
    color: var(--on-dark-muted);
    font-size: 0.875rem;
    text-decoration: none;
  }
  .to-top:hover {
    color: var(--on-dark);
  }
  .footer-legal {
    display: flex;
    gap: 24px;
    font-size: 0.875rem;
  }
  .footer-legal a {
    color: var(--on-dark-muted);
    text-decoration: none;
    transition: color 200ms ease-out;
  }
  .footer-legal a:hover {
    color: var(--on-dark);
  }
  /* Giant wordmark cropped by the card edge, fading as it goes. */
  .footer-wordmark {
    margin-top: 40px;
    padding-bottom: 40px;
    user-select: none;
    display: flex;
    justify-content: center;
  }
  .wordmark {
    font-family: var(--font-display);
    font-size: clamp(3.5rem, 12.5vw, 12rem);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.15;
    text-align: center;
    white-space: nowrap;
    margin-bottom: 0;
    background: linear-gradient(
      180deg,
      var(--on-dark) 40%,
      rgb(255 255 255 / 0.05)
    );
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  @media (max-width: 1024px) {
    .footer-top {
      grid-template-columns: 1fr 1fr 1fr;
      gap: 32px;
    }
    .footer-brand {
      grid-column: 1 / -1;
    }
  }
  @media (max-width: 640px) {
    .footer {
      padding: 0 16px 16px;
    }
    .footer-card {
      padding: 48px 24px 0;
      border-radius: 20px;
    }
    .footer-top {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
