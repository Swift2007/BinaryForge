<!-- BinaryForge logo. OWNER: to replace the artwork, keep the file names:
     public/binaryforge-logo-light.svg (dark text, for light backgrounds),
     public/binaryforge-logo.svg (light text, for dark backgrounds).
     Props: tone ('light' on light backgrounds, 'dark' on dark ones). -->
---
interface Props {
  tone?: 'light' | 'dark';
}
const { tone = 'light' } = Astro.props;
const src =
  tone === 'dark' ? '/binaryforge-logo.svg' : '/binaryforge-logo-light.svg';
---

<span class="logo">
  <img
    src={src}
    alt="BinaryForge"
    width="168"
    height="32"
    loading="eager"
    fetchpriority="high"
  />
</span>

<style>
  .logo {
    display: inline-flex;
    line-height: 0;
  }
  .logo img {
    width: 168px;
    height: 32px;
  }
</style>
